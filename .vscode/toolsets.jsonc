{
    // ─────────────────────────────────────────────────────────────────────────
    // chainskills — Custom Toolsets
    // ─────────────────────────────────────────────────────────────────────────
    //
    // ⚠️  IMPORTANT — DO NOT ENABLE GLOBALLY
    // These toolsets are defined for DOCUMENTATION purposes only.
    // Each custom agent explicitly lists individual tools in its `tools`
    // frontmatter rather than referencing these toolset names.
    //
    // WHY: Toolsets auto-appear in the global tool picker and get activated
    // for ALL agents, including ones that should be read-only. This causes
    // VS Code to crash when too many tools (>128) are active simultaneously.
    //
    // HOW TO USE SAFELY:
    //   1. Reference a toolset name in a specific agent's `tools` frontmatter:
    //      tools: ['readonly', 'fetch']
    //   2. Or keep as-is — agents already list individual tool names directly.
    //
    // ─────────────────────────────────────────────────────────────────────────
    "readonly": {
        // Read-only exploration — for Research, Architect, Review, CopilotExpert
        "tools": [
            "readFile",
            "listDirectory",
            "fileSearch",
            "textSearch",
            "codebase",
            "usages",
            "problems"
        ],
        "description": "Read-only codebase exploration — no writes, no side effects",
        "icon": "search"
    },
    "editing": {
        // Full editing — for Extension agent (implementation tasks)
        "tools": [
            "readFile",
            "listDirectory",
            "fileSearch",
            "textSearch",
            "codebase",
            "usages",
            "problems",
            "editFiles",
            "createFile",
            "createDirectory",
            "runInTerminal"
        ],
        "description": "Full editing capabilities — read + write + terminal",
        "icon": "edit"
    },
    "research": {
        // Research + web access — for Research agent
        "tools": [
            "readFile",
            "codebase",
            "fetch",
            "textSearch",
            "fileSearch"
        ],
        "description": "Web research + codebase — fetch external docs + local context",
        "icon": "globe"
    }
}