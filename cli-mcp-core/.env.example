# ──────────────────────────────────────────────
# CHAINSKILLS
# ──────────────────────────────────────────────
CHAINSKILLS_LOG_LEVEL=debug          # debug | info | warn | error
CHAINSKILLS_STATE_BACKEND=memory     # memory | sqlite | redis
CHAINSKILLS_EXECUTOR=mastra          # simple | mastra
CHAINSKILLS_WORKFLOWS_DIR=./workflows
CHAINSKILLS_GLOBAL_DIR=~/.chainskills
CHAINSKILLS_SHELL_TIMEOUT=30000      # Timeout (ms) pour @call shell.exec
CHAINSKILLS_SHELL_ALLOWLIST=echo,cat,ls,grep,find,curl,git,node,npm,pnpm,npx  # Commandes shell autorisées

# ──────────────────────────────────────────────
# MCP
# ──────────────────────────────────────────────
MCP_SERVER_PORT=3001                 # Port pour chainskills serve
MCP_TRANSPORT=stdio                  # stdio | http
MCP_SERVER_NAME=chainskills          # Nom du serveur MCP
MCP_SERVER_VERSION=0.3.0             # Version du serveur MCP
MCP_SERVERS=                         # JSON config for external MCP servers (e.g. '{"myserver":{"command":"node","args":["server.js"]}}')

# ──────────────────────────────────────────────
# MASTRA (orchestration)
# ──────────────────────────────────────────────
MASTRA_LOG_LEVEL=info

# ──────────────────────────────────────────────
# AGENT (@agent / @handoff directives)
# ──────────────────────────────────────────────
AGENT_API_KEY=                       # PRODUCTION: Secret Manager (Infisical, Doppler, Vault)
AGENT_BASE_URL=https://api.openai.com/v1  # OpenAI-compatible endpoint (Ollama, LM Studio, Groq...)
AGENT_MODEL=gpt-4o-mini             # Model identifier

# ──────────────────────────────────────────────
# REGISTRY
# ──────────────────────────────────────────────
CHAINSKILLS_REGISTRY_URL=https://registry.chainskills.dev
