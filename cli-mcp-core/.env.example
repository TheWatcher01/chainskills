# ──────────────────────────────────────────────
# CHAINSKILLS
# ──────────────────────────────────────────────
CHAINSKILLS_LOG_LEVEL=debug          # debug | info | warn | error
CHAINSKILLS_STATE_BACKEND=memory     # memory | sqlite | redis
CHAINSKILLS_WORKFLOWS_DIR=./workflows
CHAINSKILLS_GLOBAL_DIR=~/.chainskills

# ──────────────────────────────────────────────
# MCP
# ──────────────────────────────────────────────
MCP_SERVER_PORT=3001                 # Port pour chainskills serve

# ──────────────────────────────────────────────
# MASTRA (orchestration)
# ──────────────────────────────────────────────
MASTRA_LOG_LEVEL=info

# ──────────────────────────────────────────────
# LLM PROVIDERS (pour @agent directives)
# ──────────────────────────────────────────────
OPENAI_API_KEY=                      # PRODUCTION: Secret Manager (Infisical, Doppler, Vault)
ANTHROPIC_API_KEY=                   # PRODUCTION: Secret Manager (Infisical, Doppler, Vault)

# ──────────────────────────────────────────────
# REGISTRY
# ──────────────────────────────────────────────
CHAINSKILLS_REGISTRY_URL=https://registry.chainskills.dev
