{
  "name": "chainskills",
  "version": "0.1.0",
  "description": "Compose, share, and run AI agent workflows written in natural language",
  "type": "module",
  "bin": {
    "chainskills": "./bin/cli.mjs"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./parser": {
      "import": "./dist/adapters/parser/markdown-parser.mjs",
      "types": "./dist/adapters/parser/markdown-parser.d.mts"
    },
    "./runtime": {
      "import": "./dist/adapters/executor/simple-executor.mjs",
      "types": "./dist/adapters/executor/simple-executor.d.mts"
    }
  },
  "files": [
    "dist",
    "bin",
    "templates",
    "!templates/ess",
    "README.md"
  ],
  "imports": {
    "#core/*": "./src/core/*",
    "#adapters/*": "./src/adapters/*",
    "#cli/*": "./src/cli/*",
    "#config/*": "./src/config/*",
    "#infra/*": "./src/infrastructure/*"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "obuild",
    "dev": "vitest",
    "test": "vitest run",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "ai",
    "agent",
    "workflow",
    "cli",
    "natural-language",
    "dag",
    "mcp",
    "mastra",
    "skills",
    "orchestration"
  ],
  "author": "TheWatcher01",
  "license": "MIT",
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.2.3",
    "obuild": "^0.4.22",
    "prettier": "^3.8.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@mastra/core": "latest",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "citty": "^0.2.1",
    "gray-matter": "^4.0.3",
    "picocolors": "^1.1.0",
    "remark-directive": "^4.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.0",
    "unist-util-visit": "^5.0.0",
    "vfile": "^6.0.3",
    "zod": "^3.25.0"
  }
}