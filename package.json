{
    "name": "chainskills",
    "version": "0.6.0",
    "private": true,
    "description": "Monorepo: TypeScript CLI + VS Code extension for composing and running AI agent workflows",
    "type": "module",
    "engines": {
        "node": ">=18.0.0",
        "pnpm": ">=9.0.0"
    },
    "scripts": {
        "build": "pnpm -r build",
        "test": "pnpm -r test",
        "lint": "pnpm -r lint",
        "clean": "pnpm -r clean && rm -rf node_modules .pnpm",
        "cli": "cd cli-mcp-core && pnpm build && node bin/cli.mjs",
        "extension:compile": "cd vscode-extension && pnpm compile"
    },
    "devDependencies": {},
    "pnpm": {
        "overrides": {}
    }
}